<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PlaywrightPlatform>win-x64</PlaywrightPlatform>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- WinUI looks up resources.pri or <exe name>.pri; CD renames the exe, so use the fixed name. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsAxon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <ProjectReference Include="..\WindowsAxon.Agent\WindowsAxon.Agent.csproj" />
    <ProjectReference Include="..\WindowsAxon.Windows\WindowsAxon.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\WindowsAxon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\skills\**\*" Link="app-skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludePlaywrightFromResourceIndex" BeforeTargets="_GenerateProjectPriConfigurationFiles">
    <ItemGroup>
      <_AppxLayoutAssetPackageFiles Include="@(PackagingOutputs)" Condition="'%(PackagingOutputs.NuGetPackageId)' == 'Microsoft.Playwright' or $([System.String]::Copy('%(PackagingOutputs.TargetPath)').StartsWith('.playwright'))" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- C# XAML compilation does not use MSVC; WinUI's default target assumes it is installed. -->
  <Target Name="GetVCInstallPath" />
</Project>
