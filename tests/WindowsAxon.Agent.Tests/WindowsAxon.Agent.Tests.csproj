<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlaywrightPlatform>win-x64</PlaywrightPlatform>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowsAxon.Agent\WindowsAxon.Agent.csproj" />
    <ProjectReference Include="..\..\src\WindowsAxon.Windows\WindowsAxon.Windows.csproj" />
    <ProjectReference Include="..\..\src\WindowsAxon.Eval\WindowsAxon.Eval.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.AI" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\WindowsAxon.App\DesktopChatService.cs" Link="Desktop\DesktopChatService.cs" />
    <Compile Include="..\..\src\WindowsAxon.App\WindowsSecretStore.cs" Link="Desktop\WindowsSecretStore.cs" />
    <Compile Include="..\..\src\WindowsAxon.App\WindowsAppTools.cs" Link="Desktop\WindowsAppTools.cs" />
    <Compile Include="..\..\src\WindowsAxon.App\WindowsWindowTools.cs" Link="Desktop\WindowsWindowTools.cs" />
    <Compile Include="..\..\src\WindowsAxon.App\DesktopWindow.cs" Link="Desktop\DesktopWindow.cs" />
    <Compile Include="..\..\src\WindowsAxon.App\WindowInfo.cs" Link="Desktop\WindowInfo.cs" />
    <Compile Include="..\..\src\WindowsAxon.App\Updates\*.cs" Link="Desktop\Updates\%(Filename)%(Extension)" />
    <!-- Host rules are compiled in; tests never start the elevated host executable. -->
    <Compile Include="..\..\src\WindowsAxon.ScriptHost\HostRequest.cs" Link="ScriptHost\HostRequest.cs" />
    <Compile Include="..\..\src\WindowsAxon.ScriptHost\ScriptRunner.cs" Link="ScriptHost\ScriptRunner.cs" />
    <Compile Include="..\..\src\WindowsAxon.ScriptHost\ProcessJob.cs" Link="ScriptHost\ProcessJob.cs" />
  </ItemGroup>
</Project>
